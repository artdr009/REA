{
  "name": "dna-rumble",
  "productName": "DNA Rumble",
  "version": "1.0.0",
  "description": "A colorful, original side-scrolling hero DNA fighting game",
  "author": "REA",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite src/renderer --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build:app": "electron-vite build",
    "build": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.rea.dnarumble",
    "productName": "DNA Rumble",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DNA-Rumble-${version}-win-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
